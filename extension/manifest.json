{
  "manifest_version": 3,
  "name": "AliPromo – Testeur de codes promo AliExpress",
  "short_name": "AliPromo",
  "version": "1.1.0",
  "description": "Trouve des codes promo AliExpress sur le web (Google dorks, sites de bons plans) et les teste automatiquement au paiement.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.us/*",
    "*://*.aliexpress.ru/*",
    "https://html.duckduckgo.com/*",
    "https://www.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.aliexpress.ru/*"
      ],
      "js": [
        "lib/core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.fr/search*",
        "*://www.google.be/search*",
        "*://www.google.ch/search*",
        "*://www.google.ca/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.co.uk/search*"
      ],
      "js": [
        "google-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AliPromo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}